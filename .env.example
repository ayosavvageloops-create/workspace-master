# Target URL
TARGET_URL=https://example.com/register

# Anthropic API key for vision model
ANTHROPIC_API_KEY=sk-ant-...

# Proxy settings (optional)
PROXY_URL=socks5://user:pass@host:port

# SMS activation service (sms-activate.org)
SMS_API_KEY=your_sms_activate_key
SMS_SERVICE=ig
SMS_COUNTRY=0

# Account data (can be overridden per-run)
ACCOUNT_FIRST_NAME=Иван
ACCOUNT_LAST_NAME=Петров
ACCOUNT_EMAIL=user@example.com
ACCOUNT_PASSWORD=SuperSecret123

# Browser
HEADLESS=false
SLOW_MO=0

# Paths
PROFILES_DIR=profiles
ACCOUNTS_FILE=accounts.xlsx
