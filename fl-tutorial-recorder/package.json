{
  "name": "fl-tutorial-recorder",
  "version": "0.1.0",
  "description": "Записывает экран FL Studio, ставит метки горячими клавишами и собирает вертикальный туториал в стиле «how i make beats».",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.fl-tutorial-recorder",
    "productName": "FL Tutorial Recorder",
    "files": [
      "main.js",
      "preload.js",
      "hud.html",
      "renderer/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "category": "public.app-category.music",
      "identity": null,
      "target": [
        "dir"
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Запись окна FL Studio для туториала.",
        "NSAudioCaptureUsageDescription": "Запись звука FL Studio для туториала."
      }
    }
  }
}
